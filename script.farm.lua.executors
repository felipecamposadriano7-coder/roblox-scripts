--[[ 
    BLOX FRUITS AUTO FARM TODOS NPCs - MOBILE
    EXCLUSIVO PRA BLOX FRUITS ID: 2753915549
]]

if game.GameId ~= 2753915549 then return end

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local VirtualInput = game:GetService("VirtualInputManager")
local player = Players.LocalPlayer

-- CONFIG
local SETTINGS = {
    FarmRange = 1000, -- DISTANCIA PRA PROCURAR
    HitRange = 25,
    TweenSpeed = 300,
    AttackCooldown = 0.15,
    BringMobs = true,
    IgnoreBoss = true -- true = não bate em boss. false = bate em tudo
}

local State = { Running = false, LastAttack = 0 }

-- UI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "BF_FarmUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = player:WaitForChild("PlayerGui")

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 240, 0, 160)
Frame.Position = UDim2.new(0, 15, 0.5, -80)
Frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
Frame.BackgroundTransparency = 0.1
Frame.Parent = ScreenGui
Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 12)

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 35)
Title.BackgroundTransparency = 1
Title.Text = "BF FARM TODOS"
Title.TextColor3 = Color3.fromRGB(255, 185, 0)
Title.TextScaled = true
Title.Font = Enum.Font.GothamBold
Title.Parent = Frame

local Status = Instance.new("TextLabel")
Status.Size = UDim2.new(1, -10, 0, 22)
Status.Position = UDim2.new(0, 5, 0, 40)
Status.BackgroundTransparency = 1
Status.Text = "Status: OFF"
Status.TextColor3 = Color3.fromRGB(255, 80, 80)
Status.TextScaled = true
Status.Font = Enum.Font.Gotham
Status.TextXAlignment = Enum.TextXAlignment.Left
Status.Parent = Frame

local TargetLabel = Instance.new("TextLabel")
TargetLabel.Size = UDim2.new(1, -10, 0, 22)
TargetLabel.Position = UDim2.new(0, 5, 0, 62)
TargetLabel.BackgroundTransparency = 1
TargetLabel.Text = "Alvo: Nenhum"
TargetLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
TargetLabel.TextScaled = true
TargetLabel.Font = Enum.Font.Gotham
TargetLabel.TextXAlignment = Enum.TextXAlignment.Left
TargetLabel.Parent = Frame

local Button = Instance.new("TextButton")
Button.Size = UDim2.new(1, -20, 0, 45)
Button.Position = UDim2.new(0, 10, 1, -55)
Button.Text = "INICIAR"
Button.TextScaled = true
Button.Font = Enum.Font.GothamBold
Button.TextColor3 = Color3.fromRGB(255,255,255)
Button.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 8)
Button.Parent = Frame

-- FUNCOES
local function GetChar() return player.Character or player.CharacterAdded:Wait() end
local function GetHRP() return GetChar():WaitForChild("HumanoidRootPart", 5) end

local function GetNPCs()
    local npcs = {}
    for _, v in pairs(workspace.Enemies:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
            -- FILTRO NOVO: pega qualquer um vivo que não seja player
            local isPlayer = Players:GetPlayerFromCharacter(v)
            local isBoss = string.find(v.Name, "Boss") -- detecta se tem "Boss" no nome
            
            if v.Humanoid.Health > 0 and not isPlayer then
                if SETTINGS.IgnoreBoss and isBoss then
                    -- pula boss
                else
                    table.insert(npcs, v)
                end
            end
        end
    end
    return npcs
end

local function GetClosestNPC(npcs)
    local hrp = GetHRP()
    if not hrp then return end
    local closest, dist = nil, SETTINGS.FarmRange
    for _, npc in pairs(npcs) do
        local d = (npc.HumanoidRootPart.Position - hrp.Position).Magnitude
        if d < dist then
            closest = npc
            dist = d
        end
    end
    return closest
end

local function TweenTo(pos)
    local hrp = GetHRP()
    if not hrp then return end
    local distance = (pos - hrp.Position).Magnitude
    local tweenInfo = TweenInfo.new(distance / SETTINGS.TweenSpeed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(pos)})
    tween:Play()
    return tween
end

local function CanAttack() return tick() - State.LastAttack >= SETTINGS.AttackCooldown end

local function Attack(npc)
    if not CanAttack() then return end
    local hrp = GetHRP()
    if not hrp or not npc:FindFirstChild("HumanoidRootPart") then return end
    
    if SETTINGS.BringMobs then
        npc.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 0, -4)
        npc.HumanoidRootPart.Anchored = true
    end
    
    VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    State.LastAttack = tick()
end

-- LOOP
local function Farm()
    while State.Running do
        local hrp = GetHRP()
        if not hrp or GetChar().Humanoid.Health <= 0 then
            Status.Text = "Status: Morto"
            task.wait(3)
        else
            local npcs = GetNPCs()
            local target = GetClosestNPC(npcs)
            
            if target then
                TargetLabel.Text = "Alvo: "..target.Name
                local tween = TweenTo(target.HumanoidRootPart.Position)
                if tween then tween.Completed:Wait() end
                
                while target.Parent and target.Humanoid.Health > 0 and State.Running do
                    Attack(target)
                    task.wait(0.05)
                end
                if target.Parent then target.HumanoidRootPart.Anchored = false end
            else
                TargetLabel.Text = "Alvo: Procurando..."
                task.wait(1)
            end
        end
        task.wait(0.1)
    end
end

-- BOTAO
Button.MouseButton1Click:Connect(function()
    State.Running = not State.Running
    if State.Running then
        Status.Text = "Status: ON"
        Status.TextColor3 = Color3.fromRGB(80, 255, 80)
        Button.Text = "PARAR"
        Button.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
        task.spawn(Farm)
    else
        Status.Text = "Status: OFF"
        Status.TextColor3 = Color3.fromRGB(255, 80, 80)
        TargetLabel.Text = "Alvo: Nenhum"
        Button.Text = "INICIAR"
        Button.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
    end
end)